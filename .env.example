# Copy to .env (git-ignored). Nothing here is ever committed.
#
# Your Anthropic API key. It is read by the SERVER only and is never sent to
# the browser: the page calls this app's own /api/explain route, and only the
# server talks to Anthropic. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Leave the app fully usable without a key — every number on the page
# is computed from climate data, so only the written narration needs Claude.
CLIMATELENS_MODEL=claude-opus-5
CLIMATELENS_PORT=8099
